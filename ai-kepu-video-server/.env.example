# .env 文件示例
# 复制此文件为 .env 并填入真实配置。不要提交 .env。

# LLM 配置
# 可选；未设置时按 model 前缀或已知 base_url 推断，无法识别则归入 custom
LLM_PROVIDER=
LLM_PROTOCOL=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 旧版 Anthropic 兼容配置（可选；未设置 LLM_* 时作为回退）
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5

# 豆包 TTS 配置
TTS_PROVIDER=doubao
DOUBAO_TTS_API_URL=https://openspeech.bytedance.com/api/v1/tts
# access_token: 旧版 AppID/Access Token；api_key: 火山新版 API Key 鉴权
DOUBAO_TTS_AUTH_METHOD=access_token
DOUBAO_TTS_APPID=
DOUBAO_TTS_TOKEN=
DOUBAO_TTS_API_KEY=
DOUBAO_TTS_CLUSTER=volcano_tts
DOUBAO_TTS_DEFAULT_VOICE=zh_male_jieshuoxiaoming_moon_bigtts

# 小米 MiMo TTS 配置（provider=mimo 时使用，不要提交真实 API Key）
MIMO_TTS_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
MIMO_TTS_API_KEY=
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_TTS_DEFAULT_VOICE=冰糖
MIMO_TTS_FORMAT=wav
MIMO_TTS_STYLE_PROMPT=自然清晰，适合中文短视频旁白。

# 图像生成配置
SEEDREAM_API_URL=https://apihub.agnes-ai.com/v1/images/generations
SEEDREAM_API_KEY=
SEEDREAM_MODEL=agnes-image-2.1-flash
SEEDREAM_SIZE=auto

# 生成并发配置（也可在前端“模型配置”页修改；Agnes 默认 8 路 worker，滚动 60 秒最多请求 20 次）
TTS_CONCURRENCY=1
IMAGE_CONCURRENCY=8

# 日志配置。日常使用 INFO；排查底层请求时临时改 DEBUG。
LOG_LEVEL=INFO
